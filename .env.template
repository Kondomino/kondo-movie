# kondo-movie environment template.
# Copy to .env and fill in values for the providers you actually use
# (storage / DB / vendors). Anything not set will use sensible defaults
# or simply degrade (e.g. webhook + classification cache silently no-op
# when their tokens are absent).

# ---------- Runtime ----------
ENVIRONMENT=dev          # dev | prod — picks PostgreSQL.DEV vs PROD config
DEPLOYMENT=local         # local | flyio | cloudrun — used by logger
LOG_LEVEL=INFO
# LOG_FORMAT controls the stdout sink shape. Empty/unset = loguru pretty
# (dev-friendly colours). LOG_FORMAT=json = one compact JSON object per
# line — set this in production so the Axiom log shipper can index
# fields directly. APL queries can then filter by .engine_job_id, .tag,
# etc. without log-line regex.
LOG_FORMAT=

# ---------- Task queue (arq + Redis) ----------
# DSN for the Redis instance backing the render + webhook queues.
# Local dev: docker-compose service `redis` on the standard port.
# Production: Redis Cloud DSN, set via `fly secrets set REDIS_URL=...`.
# Format: redis://[:password@]host:port/db
# Defaults to redis://localhost:6379/0 when unset.
REDIS_URL=redis://localhost:6379/0

# ---------- Feature flags ----------
# Master kill-switch for the narration (TTS) pipeline. When `false` the
# engine skips ElevenLabs entirely regardless of what kondos-api sends in
# the `description` / `voice_id` fields of /make_movie. v1 ships with this
# off (silent renders) — flip to `true` once an ElevenLabs paid plan is
# in place. Defaults to `false` if unset.
NARRATION_ACTIVE=false

# ---------- kondos-api integration (Phase 2 wiring) ----------
# Public URL of kondos-api. Used by:
#   - classification_cache_client.py (GET/POST /internal/classifications)
# Leave empty in environments that don't have kondos-api reachable —
# the cache will silently no-op and we'll re-pay GCP Vision per render.
KONDOS_API_URL=http://localhost:3003

# Shared secret used as X-Internal-Token on outbound calls to kondos-api
# (webhook firing + classification cache). MUST match the value of
# KONDO_MOVIE_WEBHOOK_SECRET on the kondos-api side. Empty = both
# integrations skip silently with a warning.
KONDO_WEBHOOK_TOKEN=

# ---------- PostgreSQL (legacy — engine is now stateless) ----------
# kondo-movie no longer connects to Postgres directly. State lives in
# kondos-api. These vars are retained only because a few legacy code
# paths still reference them at import time; values can be empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kondo
DB_USER=postgres
DB_PASSWORD=
# Same story for the prod-side names (Render-era):
RENDER_INTERNAL_URL=
RENDER_HOSTNAME=
RENDER_DB_PORT=5432
RENDER_DB=
RENDER_USR=
RENDER_PWD=

# ---------- Storage providers ----------
# Active provider is config.yaml `Storage.PROVIDER` (DigitalOcean | GCP |
# CloudflareR2). Set credentials for whichever you point at.

# Cloudflare R2 (target for Kondomino):
CLOUDFLARE_R2_KEY_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=     # optional CDN-style serving (custom domain or pub-<id>.r2.dev)

# Digital Ocean Spaces (current default):
DIGITAL_OCEAN_STORAGE_KEY_ID=
DIGITAL_OCEAN_STORAGE_SECRET=
DIGITAL_OCEAN_ORIGIN_ENDPOINT=
DIGITAL_OCEAN_CDN_ENDPOINT=

# ---------- GCP service-account key (optional) ----------
# Path to a Google Cloud service-account JSON key file. Read by:
#   - gcp/storage.py (legacy GCS adapter; only when Storage.PROVIDER=GCP)
#   - gcp/secret.py (Secret Manager; only when ENABLE_EMAIL_SERVICES=true)
#   - ai/image_analyzer.py (Cloud Vision; only on legacy classification path)
# Leave empty in kondomino's CloudflareR2 + LazySecretManager + cache-only
# defaults — none of the above paths execute and ADC is not required.
GCP_SERVICE_ACCOUNT_KEY_PATH=

# ---------- AI / vendor APIs (referenced from config.yaml `Secret.*`) ----------
# Each is read by gcp/secret.py — empty values fall back to the named env
# var directly when GCP Secret Manager isn't available.
_OPENAI_API_KEY=
_ELEVEN_LABS_API_KEY=
_ASSEMBLY_AI_TRANSCRIBER_API_KEY=
_MANDRILL_API_KEY=             # transactional email (Mailchimp/Mandrill)
_MAILCHIMP_API_KEY=
_GOOGLE_MAPS_API_KEY=
_SHORT_IO=                     # short.io URL shortening
_SCRAPFLY_API_KEY=

# ---------- Auth ----------
# JWT signing for shareable/render-video tokens (account/jwt_manager.py).
JWT_SECRET=
